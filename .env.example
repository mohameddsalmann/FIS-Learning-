# Neon PostgreSQL pooled connection string. Use a development database locally.
DATABASE_URL=
# Optional direct connection for migration deployment when required.
DIRECT_URL=

# Generate a unique value for each environment. Never commit actual credentials.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# A private Vercel Blob store connected to this application.
BLOB_READ_WRITE_TOKEN=

# Live automatic inference only uses compatible verified-free routes.
OPENROUTER_API_KEY=
# Check each credential's project tier in Google AI Studio before enabling it.
GEMINI_API_KEY_PRIMARY=
# GOOGLE_API_KEY is accepted as a primary alias when the explicit primary is empty.
GEMINI_PRIMARY_FREE_TIER_CONFIRMED=false
GEMINI_API_KEY_SECONDARY=
GEMINI_SECONDARY_FREE_TIER_CONFIRMED=false

# GroqCloud is separate from xAI. Groq_API_KEY is accepted as a legacy spelling.
GROQ_API_KEY=
GROQ_FREE_PLAN_CONFIRMED=false

# Optional xAI stays disabled until explicitly activated for one exact model.
XAI_API_KEY=
XAI_MODEL=
XAI_INFERENCE_MODE=disabled

FIS_AI_DAILY_BUDGET=120
# Shared OpenRouter provider-work cap. Set to the allowance confirmed for the workspace.
FIS_OPENROUTER_DAILY_BUDGET=50
